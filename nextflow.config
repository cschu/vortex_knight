manifest {
	author = "Fabian Springer, Selin Pekel, Jakob Wirbel, Christian Schudoma"
	defaultBranch = "main"
	description = "Ensemble taxonomic microbiome profiling"
	name = "vortex_knight"
	nextflowVersion = ">=21.10.4"
	version = "0.17.6"
}

params {
	run_qa = true
	run_qc = true
	remove_host = false
	drop_orphans = true
	amplicon_seq = false
	run_basecounts = true
	do_bam2fq_conversion = true // vknight bam input requires this
	decon_mode = "bwa_mem"
	mapseq_bin = "mapseq"
	skip_collate = true

	idtaxa_error_rate_threshold = 40
	idtaxa_strand = "both"
	kraken2_min_hit_groups = 10
	motus_full_rank_taxonomy = false
	motus_min_length = 75 // 30  // 75?
	motus_n_marker_genes = 3 //1 // 3?
	motus_print_counts = false
	motus_readcount_type = "insert.scaled_counts"
	motus_tax_level = "mOTU"

	qc_minlen = 50
	qc_params_shotgun = "qtrim=rl trimq=3 maq=25 ktrim=r k=23 mink=11 hdist=1 ftm=5 entropy=0.5 entropywindow=50 entropyk=5 tpe tbo"
	// pathseq_db_filter_bwa_image
	// pathseq_db_kmer_file
	// pathseq_db_microbe_bwa_image
	// pathseq_db_microbe_dict
	// pathseq_db_microbe_fasta
	// pathseq_db_taxonomy_file
	pathseq_filter_duplicates = true
	pathseq_min_clipped_read_length = 50 // 31 // 40?
	pathseq_skip_host_alignment = false
	pathseq_skip_quality_filters = false
	read_counter_count_mode = "-y insert.raw_counts"
	read_counter_min_length = 30
}

singularity {
	enabled = false
	autoMounts = true
}

docker {
	enabled = true
}

process {
	errorStrategy = {task.attempt <= 3 ? "retry" : "ignore"}
	maxRetries = 3
	withLabel: bbduk {
		cpus = 4
		memory = {8.GB * task.attempt}
		time = {'2h' * task.attempt}
	}
	withName: bam2fq {
		cpus = 8
		memory = {bam.size() < 10.GB ? 8.GB * task.attempt : (bam.size() < 30.GB ? 16.GB * task.attempt : 32.GB * task.attempt)}
		time = {'2h' * task.attempt}

	}
	withName: fq2bam {
		cpus = 2
		memory = {32.GB * task.attempt}
		time = {'2h' * task.attempt}
	}
	withLabel: kraken2 {
		cpus = 8
		memory = {64.GB * task.attempt}
		time = {'8h' * task.attempt}
	}
	withName: motus {
		cpus = 6
		memory = {16.GB * task.attempt}
		time = {'8h' * task.attempt}
	}
	withName: pathseq {
		cpus = 1
		memory = {256.GB * task.attempt}
		time = {'8h' * task.attempt}
	}

}